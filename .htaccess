# Thryvmax — canonical host and URL redirects (Apache / LiteSpeed on Hostinger)
# HTTP -> HTTPS is left to Hostinger's "Force HTTPS" setting, so these rules can't loop
# behind the CDN (which may reach the origin over plain HTTP). Targets are absolute https://www
# so every case below is a single hop.
<IfModule mod_rewrite.c>
RewriteEngine On

# Renamed pages (spelling fixes) -> new URL, one hop from any host
RewriteRule ^custom-buisness-automation-solutions\.html$ https://www.thryvmax.com/custom-business-automation-solutions.html [L,R=301,NC]

# /index.html -> / (direct browser requests only, so the server can still serve index.html for /)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://www.thryvmax.com/ [L,R=301]

# Bare domain -> www
RewriteCond %{HTTP_HOST} ^thryvmax\.com$ [NC]
RewriteRule ^ https://www.thryvmax.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------------------------------------
# Caching. CSS/JS links carry a content fingerprint (?v=..., stamped by tools/version-assets.py),
# so they can be cached for a year and still update the moment they change. Fonts, vendor
# libraries and images are cached for a year too: to replace an image, give it a new file name.
# Pages are always revalidated, so a new deploy (and new fingerprints) is picked up at once.
# ---------------------------------------------------------------------------------------------
<IfModule mod_mime.c>
AddType image/avif .avif
AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(css|js|woff2|avif|webp|png|jpe?g|gif|svg|ico)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
